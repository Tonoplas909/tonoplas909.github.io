---
import { profil } from '../data/profil';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { filDeFer } from '../lib/noyau';
import { homePath, sectionPath } from '../lib/routes';

// GitHub Pages sert cette page pour toute adresse inconnue, sous n'importe quel préfixe : la langue
// n'est connue qu'au chargement, d'après l'URL. Les deux versions sont donc dans la page, et un petit
// script révèle l'anglaise sous /en/. Sans JavaScript, la version française reste affichée.
const lang = 'fr';
const versions: { code: Lang; cache: boolean }[] = [
  { code: 'fr', cache: false },
  { code: 'en', cache: true },
];

// Le noyau, et une liaison qui part vers un nœud fantôme et se rompt en chemin
const gabarit = { largeur: 600, hauteur: 360, cx: 170, cy: 200, echelle: 62, echelleNoeuds: 1 };
const noyau = filDeFer(gabarit, { yaw: -0.5, pitch: -0.3 }, 1, 2);
---

<Base lang={lang} title={`${t(lang, 'introuvable.titre')} · ${profil.nom}`} description={t(lang, 'introuvable.texte')} noindex>
  <section class="container introuvable">
    <svg class="liaison" viewBox="0 0 600 360" aria-hidden="true">
      <path d={noyau.arriere} class="noyau-arriere"></path>
      <path d={noyau.avant} class="noyau-avant"></path>
      <path d={noyau.sommets} class="sommets"></path>
      <path d="M 290 160 L 400 120" class="lien"></path>
      <path d="M 413 104 L 431 122 M 431 104 L 413 122" class="rupture"></path>
      <path d="M 444 106 L 548 68" class="lien-fantome"></path>
      <circle cx="290" cy="160" r="3.5" class="ancre"></circle>
      <circle cx="560" cy="64" r="10" class="fantome"></circle>
    </svg>

    {
      versions.map(({ code, cache }) => (
        <div class="version" lang={code} data-introuvable={code} hidden={cache}>
          <p class="surtitre">{t(code, 'introuvable.surtitre')}</p>
          <h1>{t(code, 'introuvable.titre')}</h1>
          <p class="texte">{t(code, 'introuvable.texte')}</p>
          <div class="actions">
            <a class="bouton bouton--primaire" href={homePath(code)}>
              <span aria-hidden="true">←</span> {t(code, 'introuvable.retour')}
            </a>
            <a class="bouton bouton--secondaire" href={sectionPath(code, 'projets')}>
              {t(code, 'introuvable.projets')}
            </a>
          </div>
        </div>
      ))
    }
  </section>
</Base>

<script>
  import { langFromPath } from '../lib/routes';

  if (langFromPath(location.pathname) === 'en') {
    document.documentElement.lang = 'en';
    document.querySelector<HTMLElement>('[data-introuvable="fr"]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-introuvable="en"]')!.hidden = false;
  }
</script>

<style>
  /* Le texte à gauche, la liaison rompue à droite ; sur téléphone, l'illustration passe au-dessus */
  .introuvable {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: 'texte art';
    align-items: center;
    gap: 32px 48px;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .liaison {
    grid-area: art;
    width: 100%;
    max-width: 640px;
    overflow: visible;
  }

  @media (max-width: 900px) {
    .introuvable {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'art'
        'texte';
    }
  }

  .noyau-arriere {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.2;
    stroke-dasharray: 3 4;
  }

  .noyau-avant {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .sommets {
    fill: var(--accent);
  }

  .lien {
    stroke: var(--accent);
    stroke-opacity: 0.8;
    stroke-width: 1.3;
  }

  .rupture {
    stroke: var(--statut);
    stroke-width: 2;
  }

  .lien-fantome {
    stroke: var(--accent);
    stroke-opacity: 0.35;
    stroke-width: 1.3;
    stroke-dasharray: 3 7;
  }

  .ancre {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.2;
  }

  .fantome {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .version {
    grid-area: texte;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .surtitre {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--statut);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 88px);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .texte {
    max-width: 480px;
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
