---
import { profil } from '../data/profil';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { homePath } from '../lib/routes';

// GitHub Pages sert cette page pour toute adresse inconnue, sous n'importe quel préfixe : la langue
// n'est connue qu'au chargement, d'après l'URL. Les deux versions sont donc dans la page, et un petit
// script révèle l'anglaise sous /en/. Sans JavaScript, la version française reste affichée.
const lang = 'fr';
const versions: { code: Lang; cache: boolean }[] = [
  { code: 'fr', cache: false },
  { code: 'en', cache: true },
];
---

<Base lang={lang} title={`${t(lang, 'introuvable.titre')} · ${profil.nom}`} description={t(lang, 'introuvable.texte')} noindex>
  <section class="container introuvable">
    {
      versions.map(({ code, cache }) => (
        <div class="version" lang={code} data-introuvable={code} hidden={cache}>
          <p class="code" aria-hidden="true">
            404
          </p>
          <h1>{t(code, 'introuvable.titre')}</h1>
          <p class="texte">{t(code, 'introuvable.texte')}</p>
          <a class="bouton bouton--primaire" href={homePath(code)}>
            {t(code, 'introuvable.retour')}
          </a>
        </div>
      ))
    }
  </section>
</Base>

<script>
  import { langFromPath } from '../lib/routes';

  if (langFromPath(location.pathname) === 'en') {
    document.documentElement.lang = 'en';
    document.querySelector<HTMLElement>('[data-introuvable="fr"]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-introuvable="en"]')!.hidden = false;
  }
</script>

<style>
  .introuvable {
    padding-top: 72px;
    padding-bottom: 96px;
  }

  .version {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(72px, 16vw, 140px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .texte {
    max-width: 560px;
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-2);
  }
</style>
