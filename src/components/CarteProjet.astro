---
import { Image } from 'astro:assets';
import { projets } from '../data/projets';
import type { Lang, Projet } from '../data/types';
import { t } from '../i18n/ui';
import { imagesDuProjet } from '../lib/images';
import { projectPath } from '../lib/routes';

interface Props {
  projet: Projet;
  lang: Lang;
}

const { projet, lang } = Astro.props;

// La première image du projet sert de vignette ; sans image, la carte montre son numéro en contour.
const [vignette] = imagesDuProjet(projet.id);

const numero = String(projets.indexOf(projet) + 1).padStart(2, '0');
const pageProjet = projectPath(lang, projet.id);
const libelleDemo = t(lang, projet.categorie === 'jeu' ? 'projets.jouer' : 'projets.voirSite');
const repere = [
  numero,
  t(lang, `categorie.${projet.categorie}`),
  ...(projet.categorie === 'jeu' && projet.liens.demo ? [t(lang, 'projets.jouable')] : []),
].join(' · ');
const stack = projet.stack.join(' · ');
---

<li
  class:list={['carte-projet', { 'carte-projet--vedette': projet.vedette, 'carte-projet--image': vignette }]}
  data-projet-id={projet.id}
  data-categorie={projet.categorie}
>
  <div class="vignette">
    {
      vignette ? (
        <Image src={vignette} alt="" width={640} height={360} format="webp" loading="lazy" />
      ) : (
        <div class="vignette-vide" aria-hidden="true">
          <span class="vignette-numero">{numero}</span>
          <span class="vignette-note">{t(lang, 'projets.capture')}</span>
        </div>
      )
    }
  </div>
  <div class="corps">
    <p class="repere">{repere}</p>
    {projet.badge && <span class="badge">{projet.badge[lang]}</span>}
    <h2 class="titre">
      <a class="carte-lien" href={pageProjet}>{projet.titre}</a>
    </h2>
    <p class="resume">{projet.resume[lang]}</p>
    <p class="stack">{stack}</p>
    <div class="actions">
      {
        projet.liens.demo && (
          <a class="action action--demo" href={projet.liens.demo} rel="noopener noreferrer">
            {libelleDemo}
            <span aria-hidden="true"> ↗</span>
            <span class="sr-only"> ({projet.titre})</span>
          </a>
        )
      }
      <a class="action" href={projet.liens.code} rel="noopener noreferrer">
        {t(lang, 'projets.code')}
        <span aria-hidden="true"> ↗</span>
        <span class="sr-only"> ({projet.titre})</span>
      </a>
    </div>
  </div>
</li>

<style>
  .carte-projet {
    /* Trois par ligne sur ordinateur, les vedettes deux par ligne, une colonne sur téléphone */
    flex: 1 1 280px;
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .carte-projet--vedette {
    flex-basis: 440px;
  }

  .carte-projet:hover,
  .carte-projet:has(:focus-visible) {
    border-color: var(--accent);
  }

  /* L'anneau de focus entoure la carte entière, pas seulement le titre */
  .carte-projet:has(.carte-lien:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .vignette {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background-color: var(--surface-2);
  }

  .vignette :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vignette-vide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image:
      linear-gradient(#111821 1px, transparent 1px),
      linear-gradient(90deg, #111821 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .vignette-numero {
    font-family: var(--font-display);
    font-size: clamp(72px, 9vw, 150px);
    font-weight: 800;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
  }

  .vignette-note {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .corps {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px;
  }

  .carte-projet--vedette .corps {
    gap: 12px;
    padding: 24px;
  }

  .repere {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .badge {
    padding: 5px 10px;
    border: 1px solid var(--statut);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--statut);
  }

  .titre {
    margin: 0;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    line-height: 1.05;
  }

  .carte-projet--vedette .titre {
    font-size: 34px;
  }

  /* Lien étiré : la carte entière mène à la page du projet */
  .carte-lien {
    color: var(--text);
    text-decoration: none;
  }

  .carte-lien:hover {
    color: var(--text);
  }

  .carte-lien::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Le focus est montré sur la carte (voir plus haut) */
  .carte-lien:focus-visible {
    outline: none;
  }

  .resume {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-3);
  }

  .stack {
    margin: auto 0 0;
    padding-top: 4px;
    font-size: 11.5px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Au-dessus du lien étiré, pour rester cliquables séparément */
  .action {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--target);
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 12px;
    color: var(--text);
    text-decoration: none;
  }

  .action:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .action--demo {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
    font-weight: 500;
  }

  .action--demo:hover {
    background: var(--accent-hover);
    color: var(--bg);
  }

  /* Zoom de la vignette : coupé si l'utilisateur réduit les animations */
  @media (prefers-reduced-motion: no-preference) {
    .vignette :global(img) {
      transition: transform 0.3s ease;
    }

    .carte-projet:hover .vignette :global(img),
    .carte-projet:has(:focus-visible) .vignette :global(img) {
      transform: scale(1.04);
    }
  }
</style>
