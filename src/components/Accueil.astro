---
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import BlocCv from './BlocCv.astro';
import Competences from './Competences.astro';
import Hero from './Hero.astro';
import Parcours from './Parcours.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Hero lang={lang} />
<Competences lang={lang} />
<section id="projets" class="container projets" aria-labelledby="projets-titre">
  <h2 id="projets-titre" class="titre-section">{t(lang, 'projets.titre')}</h2>
  <!-- TÂCHE 6 : monter ici le filtre et les cartes de projets -->
</section>
<Parcours lang={lang} />
<BlocCv lang={lang} />

<style>
  .projets {
    padding-top: 24px;
    padding-bottom: 72px;
  }
</style>
