---
import { profil } from '../data/profil';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import Contact from './Contact.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const annee = new Date().getFullYear();
---

<footer class="site-footer" aria-label={t(lang, 'nav.contact')}>
  <span class="mentions">© {annee} {profil.nom} · {t(lang, 'pied.mentions')}</span>
  <div class="liens">
    <Contact lang={lang} />
    <a href={profil.liens.github} rel="noopener noreferrer">GitHub</a>
    <a href={profil.liens.linkedin} rel="noopener noreferrer">LinkedIn</a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--bg);
    view-transition-name: pied;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 32px;
    padding: 16px var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .mentions {
    color: var(--muted);
  }

  .liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  .liens a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text);
    text-decoration: none;
  }

  .liens a:hover {
    color: var(--accent-hover);
  }
</style>
