---
// Le noyau en miniature (en-tête, pages de section) : mêmes calculs que la scène de l'accueil, figés.
import { filDeFer } from '../lib/noyau';

interface Props {
  taille?: number;
}

const { taille = 36 } = Astro.props;
const gabarit = { largeur: 40, hauteur: 40, cx: 20, cy: 20, echelle: 9.4, echelleNoeuds: 1 };
const { avant } = filDeFer(gabarit, { yaw: 0.4, pitch: -0.35 }, 1, 0);
---

<svg class="icone-noyau" aria-hidden="true" width={taille} height={taille} viewBox="0 0 40 40">
  <path d={avant} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
</svg>

<style>
  .icone-noyau {
    flex: none;
    color: var(--accent);
  }
</style>
