---
import { profil } from '../data/profil';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { statut } from '../lib/statut';
import Contact from './Contact.astro';
import PageSection from './PageSection.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const etat = statut(lang);

// Adresse affichée d'un lien, sans protocole, « www. » ni barre finale : « github.com/Tonoplas909 »
function adresseCourte(url: string): string {
  const { host, pathname } = new URL(url);
  return `${host.replace(/^www\./, '')}${pathname}`.replace(/\/$/, '');
}
---

<PageSection lang={lang} section="contact" titre={t(lang, 'contact.titre')} lead={t(lang, 'contact.lead')}>
  <ul class="canaux">
    <li class="canal canal--principal">
      <span class="etiquette canal-etiquette">01 · {t(lang, 'contact.message')}</span>
      <span class="canal-titre">E-mail</span>
      {/* Le lien est assemblé au chargement (protection contre les robots), comme dans le pied de page */}
      <span class="canal-adresse"><Contact lang={lang} /></span>
    </li>
    <li class="canal">
      <span class="etiquette canal-etiquette">02 · {t(lang, 'contact.code')}</span>
      <a class="canal-lien" href={profil.liens.github} rel="noopener noreferrer">
        <span class="canal-titre">GitHub <span aria-hidden="true">↗</span></span>
        <span class="canal-adresse">{adresseCourte(profil.liens.github)}</span>
      </a>
    </li>
    <li class="canal">
      <span class="etiquette canal-etiquette">03 · {t(lang, 'contact.reseau')}</span>
      <a class="canal-lien" href={profil.liens.linkedin} rel="noopener noreferrer">
        <span class="canal-titre">LinkedIn <span aria-hidden="true">↗</span></span>
        <span class="canal-adresse">{profil.nom}</span>
      </a>
    </li>
  </ul>

  <section id="statut" class:list={['statut', { 'statut--disponible': etat.disponible }]} aria-labelledby="statut-titre">
    <div class="statut-textes">
      <span class="statut-point" aria-hidden="true"></span>
      <div class="statut-colonne">
        <h2 id="statut-titre" class="statut-titre">{etat.titre}</h2>
        <p class="statut-detail">{etat.detail} {!etat.disponible && t(lang, 'statut.ouvert')}</p>
      </div>
    </div>
    {
      etat.echeance && (
        <p class="echeance">
          <span class="etiquette echeance-etiquette">{t(lang, 'statut.echeance')}</span>
          <span class="echeance-valeur">{etat.echeance}</span>
        </p>
      )
    }
  </section>
</PageSection>

<style>
  .canaux {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .canal {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 220px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .canal:hover,
  .canal:has(:focus-visible) {
    border-color: var(--accent);
  }

  .canal-etiquette {
    color: var(--accent);
  }

  .canal-lien {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    color: var(--text);
    text-decoration: none;
  }

  /* Lien étiré : toute la carte est cliquable */
  .canal-lien::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .canal-lien:hover {
    color: var(--text);
  }

  .canal-titre {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 800;
    line-height: 1;
  }

  .canal-adresse {
    margin-top: auto;
    font-size: 13px;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  .canal--principal {
    border-color: var(--accent);
  }

  .canal--principal .canal-adresse :global(a) {
    font-size: 14px;
  }

  .statut {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: 32px;
    border: 1px solid var(--statut);
    border-radius: var(--radius);
    scroll-margin-top: 24px;
  }

  .statut-textes {
    display: flex;
    align-items: center;
    gap: 22px;
    min-width: 0;
  }

  .statut-point {
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--statut);
    box-shadow: 0 0 0 7px var(--statut-halo);
  }

  .statut-colonne {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .statut-titre {
    margin: 0;
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    color: var(--statut);
  }

  .statut-detail {
    max-width: 70ch;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .echeance {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    margin: 0;
  }

  .echeance-etiquette {
    color: var(--statut);
  }

  .echeance-valeur {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    line-height: 1;
  }

  .statut--disponible {
    border-color: var(--accent);
  }

  .statut--disponible .statut-point {
    background: var(--accent);
    box-shadow: 0 0 0 7px var(--accent-halo);
  }

  .statut--disponible .statut-titre {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .canal {
      min-height: 0;
      padding: 22px;
    }

    .statut {
      padding: 20px;
    }

    .statut-textes {
      align-items: flex-start;
    }

    .statut-point {
      margin-top: 8px;
    }

    .statut-titre {
      font-size: 26px;
    }

    .echeance {
      width: 100%;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      padding-top: 12px;
      border-top: 1px solid var(--line-strong);
    }

    .echeance-valeur {
      font-size: 26px;
    }
  }
</style>
