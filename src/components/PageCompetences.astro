---
import { groupesCompetences } from '../data/competences';
import { profil } from '../data/profil';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { projetsUtilisant } from '../lib/competences';
import { projectPath } from '../lib/routes';
import PageSection from './PageSection.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const groupes = groupesCompetences.map((groupe) => ({
  id: groupe.id,
  titre: t(lang, `competences.groupe.${groupe.id}`),
  items: groupe.items.map((item) => ({
    nom: item.nom,
    contextes: item.contextes ?? [],
    projets: projetsUtilisant(item.nom).map((projet) => ({ titre: projet.titre, href: projectPath(lang, projet.id) })),
  })),
}));
---

<PageSection lang={lang} section="competences" titre={t(lang, 'competences.titre')} lead={t(lang, 'competences.lead')}>
  <div class="groupes">
    {
      groupes.map((groupe) => (
        <section class="groupe" aria-labelledby={`groupe-${groupe.id}`}>
          <h2 id={`groupe-${groupe.id}`} class="titre-bloc">
            {groupe.titre}
          </h2>
          <ul class="items">
            {groupe.items.map((item) => (
              <li class="item">
                <span class="item-nom">{item.nom}</span>
                {(item.contextes.length > 0 || item.projets.length > 0) && (
                  <span class="item-usages">
                    <span class="sr-only">{t(lang, 'competences.utilisee')} : </span>
                    {item.contextes.map((contexte) => (
                      <span class="pastille">{contexte}</span>
                    ))}
                    {item.projets.map((projet) => (
                      <a class="pastille pastille--lien" href={projet.href}>
                        {projet.titre}
                      </a>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <dl class="bandeau">
    <div class="bandeau-ligne">
      <dt class="etiquette">{t(lang, 'competences.langues')}</dt>
      <dd>{profil.langues[lang].join(' · ')}</dd>
    </div>
    <div class="bandeau-ligne">
      <dt class="etiquette">{t(lang, 'competences.methodes')}</dt>
      <dd>{t(lang, 'competences.methodes.valeur')}</dd>
    </div>
  </dl>
</PageSection>

<style>
  .groupes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 520px), 1fr));
    gap: 20px;
  }

  .groupe {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .item-nom {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
  }

  .item-usages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Les liens font 44 px de haut (cible tactile) : les autres pastilles s'alignent dessus */
  .item-usages .pastille {
    min-height: var(--target);
  }

  .pastille--lien {
    color: var(--text-2);
    text-decoration: none;
  }

  .pastille--lien:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .bandeau {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 20px;
    margin: 0;
  }

  .bandeau-ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 22px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .bandeau-ligne dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .groupe {
      padding: 18px;
    }

    .item {
      flex-direction: column;
      align-items: flex-start;
    }

    .item-nom {
      font-size: 21px;
    }

    .bandeau-ligne {
      padding: 14px 0;
      border: 0;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
    }
  }
</style>
