---
import { profil } from '../data/profil';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { profilLines, type LigneProfil } from '../lib/hero';

interface Props {
  lang: Lang;
}

interface Jeton {
  classe?: 'str' | 'num';
  texte: string;
}

const { lang } = Astro.props;

// Un jeton coloré (chaîne, nombre) ou du texte brut (crochets, virgules) : pas d'espace parasite dans le gabarit
function jetons(valeur: LigneProfil['value']): Jeton[] {
  if (typeof valeur === 'number') return [{ classe: 'num', texte: String(valeur) }];
  if (Array.isArray(valeur)) {
    return [
      { texte: '[' },
      ...valeur.flatMap((element, i): Jeton[] => [
        ...(i > 0 ? [{ texte: ', ' }] : []),
        { classe: 'str', texte: `"${element}"` },
      ]),
      { texte: ']' },
    ];
  }
  return [{ classe: 'str', texte: `"${valeur}"` }];
}

const [prenom, ...reste] = profil.nom.split(' ');
const nomDeFamille = reste.join(' ');
const variable = prenom.toLowerCase();
const lignes = profilLines(lang);
---

<section class="container hero" aria-labelledby="hero-titre">
  <div class="presentation">
    <p class="statut">
      <span class="point" aria-hidden="true"></span>
      <span>{t(lang, 'hero.statut')}</span>
    </p>
    <h1 id="hero-titre">{prenom}{' '}<br />{nomDeFamille}</h1>
    <p class="accroche">{t(lang, 'hero.accroche')}</p>
    <div class="actions">
      <a class="bouton bouton--primaire" href="#projets">{t(lang, 'hero.voirProjets')}</a>
      <a class="bouton bouton--secondaire" href="#cv">{t(lang, 'hero.telechargerCv')}</a>
    </div>
  </div>

  <figure class="fiche">
    <figcaption class="fiche-nom">profil.ts</figcaption>
    <pre class="code"><code><span class="ligne"><span class="kw">const</span> {variable} = {'{'}</span>{lignes.map(({ key, value }) => (
      <span class="ligne ligne--dans">{key}: {jetons(value).map((jeton) => (jeton.classe ? <span class={jeton.classe}>{jeton.texte}</span> : jeton.texte))},</span>
    ))}<span class="ligne">{'};'}</span></code></pre>
  </figure>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    padding-top: 72px;
    padding-bottom: 56px;
  }

  .presentation {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .statut {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }

  .point {
    flex: none;
    /* centré sur la première ligne de texte (14 px sur 1,6 de hauteur de ligne) */
    margin-top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ok);
  }

  h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(44px, 7vw, 84px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .accroche {
    max-width: 560px;
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .fiche {
    flex: 0 1 420px;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .fiche-nom {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .code {
    margin: 0;
    padding: 20px 20px 24px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 26px;
    color: var(--text-2);
    /* Les lignes sont des blocs : le retour à la ligne reste possible sur téléphone */
    white-space: normal;
  }

  /* La feuille de style du navigateur impose sa propre police à chasse fixe à <code> */
  .code code {
    font: inherit;
  }

  .ligne {
    display: block;
  }

  /* Retrait de 20 px ; une ligne qui passe à la ligne est retirée de 20 px de plus */
  .ligne--dans {
    padding-left: 40px;
    text-indent: -20px;
  }

  .kw {
    color: var(--code-kw);
  }

  .str {
    color: var(--code-str);
  }

  .num {
    color: var(--code-num);
  }
</style>
