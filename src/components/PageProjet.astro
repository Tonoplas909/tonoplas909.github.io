---
import { projets } from '../data/projets';
import type { Lang, Projet } from '../data/types';
import { remplir, t } from '../i18n/ui';
import { voisins } from '../lib/projets';
import { projectPath, sectionPath } from '../lib/routes';
import Galerie from './Galerie.astro';

interface Props {
  lang: Lang;
  projet: Projet;
}

const { lang, projet } = Astro.props;

const position = projets.indexOf(projet) + 1;
const numero = String(position).padStart(2, '0');
const repere = [
  numero,
  t(lang, `categorie.${projet.categorie}`),
  ...(projet.categorie === 'jeu' && projet.liens.demo ? [t(lang, 'projets.jouable')] : []),
].join(' · ');
const stack = projet.stack.join(' · ');
const libelleDemo = t(lang, projet.categorie === 'jeu' ? 'projets.jouer' : 'projets.voirSite');
const { prev, next } = voisins(projet.id);
const autres = [
  { sens: 'prev', projet: prev, cle: 'projet.precedent', fleche: '←' },
  { sens: 'next', projet: next, cle: 'projet.suivant', fleche: '→' },
] as const;
---

<article class="container projet apparition">
  <div class="haut">
    <a class="retour" href={sectionPath(lang, 'projets')} data-projet-retour>
      <span aria-hidden="true">←</span>{' '}{t(lang, 'projet.retour')}
    </a>
    <span class="position">{remplir(t(lang, 'projet.numero'), { n: numero, total: String(projets.length).padStart(2, '0') })}</span>
  </div>

  <header class="entete">
    <div class="titres">
      <p class="repere">
        <span class="repere-point" aria-hidden="true"></span><span class="repere-trait" aria-hidden="true"></span>
        {repere}
      </p>
      <h1>{projet.titre}</h1>
      {projet.badge && <span class="badge">{projet.badge[lang]}</span>}
      <p class="resume">{projet.resume[lang]}</p>
    </div>
    <div class="cote">
      <div class="actions">
        {
          projet.liens.demo && (
            <a class="bouton bouton--primaire" href={projet.liens.demo} target="_blank" rel="noopener noreferrer">
              {libelleDemo} <span aria-hidden="true">↗</span>
            </a>
          )
        }
        <a class="bouton bouton--secondaire" href={projet.liens.code} target="_blank" rel="noopener noreferrer">
          {t(lang, 'projets.code')} <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="stack">{stack}</p>
    </div>
  </header>

  <Galerie lang={lang} projet={projet} />

  <div class="colonnes">
    <section class="bloc" aria-labelledby="presentation-titre">
      <h2 id="presentation-titre" class="titre-bloc">{t(lang, 'projet.presentation')}</h2>
      <div class="texte">
        {projet.description[lang].map((paragraphe) => <p>{paragraphe}</p>)}
      </div>
    </section>

    <section class="bloc" aria-labelledby="points-titre">
      <h2 id="points-titre" class="titre-bloc">{t(lang, 'projet.points')}</h2>
      <ol class="points">
        {
          projet.points[lang].map((point, index) => (
            <li>
              <span class="point-numero" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{point}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <nav class="voisins" aria-label={t(lang, 'projet.autres')}>
    {
      autres.map(({ sens, projet: voisin, cle, fleche }) => (
        <a class={`voisin voisin--${sens}`} href={projectPath(lang, voisin.id)} data-voisin={sens}>
          <span class="voisin-sens">
            {sens === 'prev' && <span aria-hidden="true">{fleche} </span>}
            {t(lang, cle)}
            {sens === 'next' && <span aria-hidden="true"> {fleche}</span>}
          </span>
          <span class="voisin-titre">{voisin.titre}</span>
        </a>
      ))
    }
  </nav>
</article>

<style>
  .projet {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 32px;
    padding-bottom: 64px;
  }

  .haut {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .retour {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--target);
    padding: 0 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }

  .retour:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .position {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .entete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
  }

  .titres {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .repere {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .repere-point {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-halo);
  }

  .repere-trait {
    width: 64px;
    height: 1px;
    background: var(--accent);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(48px, 9vw, 136px);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .badge {
    padding: 6px 12px;
    border: 1px solid var(--statut);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--statut);
  }

  .resume {
    max-width: 62ch;
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-2);
  }

  .cote {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .stack {
    margin: 0;
    font-size: 12px;
    color: var(--text-3);
  }

  .colonnes {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px 64px;
  }

  .bloc {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .texte {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 72ch;
    font-size: 15px;
    line-height: 1.75;
    color: var(--text-2);
  }

  .texte p {
    margin: 0;
  }

  .points {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.6;
  }

  .points li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .point-numero {
    color: var(--accent);
  }

  .voisins {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .voisin {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-height: var(--target);
    padding: 24px 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .voisin:hover {
    border-color: var(--accent);
  }

  .voisin--next {
    align-items: flex-end;
    text-align: right;
  }

  .voisin-sens {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .voisin-titre {
    font-family: var(--font-display);
    font-size: clamp(20px, 3vw, 34px);
    font-weight: 800;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .voisin:hover .voisin-titre {
    color: var(--accent-hover);
  }

  @media (max-width: 760px) {
    .projet {
      gap: 28px;
      padding-top: 20px;
    }

    .cote {
      align-items: flex-start;
    }

    .colonnes {
      grid-template-columns: minmax(0, 1fr);
    }

    .voisins {
      gap: 10px;
    }

    .voisin {
      padding: 16px;
    }

    .repere-trait {
      width: 40px;
    }
  }
</style>
